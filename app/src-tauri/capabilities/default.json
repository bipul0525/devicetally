{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app's own windows may call its commands; nothing else is exposed.",
  "windows": [
    "popover",
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "opener:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    "process:allow-restart"
  ]
}
