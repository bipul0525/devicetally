{
  "name": "devicetally-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "agent": "node scripts/build-agent.mjs",
    "tauri": "tauri",
    "try": "npm run prepare-bundle && DEVICETALLY_OPEN_WINDOW=1 tauri dev --release",
    "app": "npm run prepare-bundle && tauri build",
    "server": "node scripts/bundle-server.mjs",
    "prepare-bundle": "npm run agent && npm run server"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
